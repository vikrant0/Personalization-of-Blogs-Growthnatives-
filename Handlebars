<div class="blog-container" data-evg-campaign-id="{{campaign}}" data-evg-experience-id="{{experience}}" data-evg-user-group="{{userGroup}}">
    <!-- Featured blog section -->
    <div class="blog-item featured">
     <img src="{{featuredBlog.imageUrl}}" alt="{{featuredBlog.title}}" class="featured-image">
   <a href="{{featuredBlog.url}}">{{featuredBlog.title}}</a>
        <p>{{featuredBlog.category}} | {{featuredBlog.author}} | {{featuredBlog.publicationDate}}</p>
    </div>

